# CloudNova PaymentOps - environment configuration (EXAMPLE ONLY)
# Copy to .env for local development. NEVER commit .env.
# All values below are FAKE placeholders. Replace with real values in your environment.

# --- General ---
APP_ENVIRONMENT=development
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
APP_DEBUG=false
APP_TIMEZONE=UTC

# --- API ---
API_TITLE=CloudNova PaymentOps
API_PORT=8000
API_HOST=0.0.0.0
API_WORKERS=1

# --- Security ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated. A restrictive production value is preferred.
ALLOWED_HOSTS=localhost

# --- AI (non-authoritative; can be disabled) ---
AI_ENABLED=false
AI_PROVIDER=none            # none | ollama | vllm | custom
AI_BASE_URL=http://localhost:11434
AI_MODEL=none

# --- Database ---
# FAKE credentials only.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=paymentops
DATABASE_USER=paymentops
DATABASE_PASSWORD=replace-me
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Redis / queue ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Observability ---
METRICS_ENABLED=true

# --- Processing (zero-retention is the default posture) ---
ZERO_RETENTION_ENABLED=true
# Seconds a raw payload may be held in memory before redaction. 0 = immediately.
RAW_PAYLOAD_TTL_SECONDS=0

# --- Address provider ---
# auto | cloudnova | swift. "auto" uses the Swift-derived provider when SWIFT_ADDRESS_URL is set.
ADDRESS_PROVIDER=auto
# Internal URL of the paymentops-address-structuring component (ClusterIP).
SWIFT_ADDRESS_URL=
SWIFT_ADDRESS_TIMEOUT=2.0
SWIFT_ADDRESS_MAX_RETRIES=1

# --- Evolus / AMD-powered investigator (Phase 1) ---
# Server-side only. NEVER expose these to the browser or to /api/v1/info. All values below
# are placeholders. Leave EVOLUS_ENABLED=false to run PaymentOps with the investigator
# disabled; the core product works without it. See docs/PHASE1.md and
# docs/evolus/evolus-workspace-setup.md.
EVOLUS_ENABLED=false
EVOLUS_API_BASE_URL=https://api.evolus.ai/api/v1
# Application API key, sent by the backend as X-ApiKey. Placeholder only.
EVOLUS_API_KEY=
# Workspace/space id, sent by the backend as X-Application-Id.
EVOLUS_APPLICATION_ID=
# Investigation workflow and the PaymentOps Investigator agent / knowledge library ids.
EVOLUS_WORKFLOW_ID=
EVOLUS_AGENT_ID=
EVOLUS_LIBRARY_ID=
# Dedicated credential for the inbound validation WebAPI tool that Evolus calls
# (compared in constant time; distinct from the operator credential).
EVOLUS_TOOL_API_KEY=
# Bounded polling and retries for workflow status.
EVOLUS_REQUEST_TIMEOUT_SECONDS=30
EVOLUS_POLL_TIMEOUT_SECONDS=90
EVOLUS_POLL_INTERVAL_SECONDS=2
EVOLUS_MAX_RETRIES=2
# Optional tenant guard for the tool endpoint (public_id of the demo organization).
EVOLUS_DEMO_ORG_PUBLIC_ID=
